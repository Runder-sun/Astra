{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retry_result.schema.json",
  "title": "RetryResult",
  "type": "object",
  "required": ["session_id", "source_turn_id", "retry_turn_id", "status", "retry_policy"],
  "properties": {
    "session_id": { "type": "string", "minLength": 1 },
    "source_turn_id": { "type": "string", "minLength": 1 },
    "retry_turn_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "retry_policy": { "type": "string", "minLength": 1 },
    "reason": { "type": "string" }
  },
  "additionalProperties": false
}
