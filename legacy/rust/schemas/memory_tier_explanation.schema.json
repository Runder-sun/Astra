{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory_tier_explanation.schema.json",
  "title": "MemoryTierExplanation",
  "type": "object",
  "required": [
    "schema_version",
    "conformance_line",
    "canonical_path",
    "retention_policy",
    "atomic_write_policy",
    "memory_record_id",
    "tier",
    "adoption_score",
    "event_counts",
    "last_positive_event_at",
    "negative_event_count",
    "ranking_reason",
    "governance_limits",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "memory.tier_explanation.v1" },
    "conformance_line": { "type": "string", "const": "M15.memory_tier" },
    "canonical_path": { "type": "string", "minLength": 1 },
    "retention_policy": { "type": "string", "minLength": 1 },
    "atomic_write_policy": { "type": "string", "minLength": 1 },
    "memory_record_id": { "type": "string", "minLength": 1 },
    "tier": { "type": "string", "enum": ["HOT", "WARM", "COLD"] },
    "adoption_score": { "type": "number" },
    "event_counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "last_positive_event_at": { "type": "string" },
    "negative_event_count": { "type": "integer", "minimum": 0 },
    "ranking_reason": { "type": "string", "minLength": 1 },
    "governance_limits": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
