{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session_runtime_descriptor.schema.json",
  "title": "SessionRuntimeDescriptor",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "active_session_id",
    "runtime_state",
    "workspace_root"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "active_session_id": { "type": ["string", "null"], "minLength": 1 },
    "runtime_state": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "reasoning_effort": { "type": "string", "minLength": 1 },
    "permission_mode": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "workspace_root": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
