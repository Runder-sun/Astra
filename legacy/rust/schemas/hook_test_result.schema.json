{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hook_test_result.schema.json",
  "title": "HookTestResult",
  "type": "object",
  "required": ["scope", "overall_status", "tested_count"],
  "properties": {
    "scope": { "type": "string", "minLength": 1 },
    "overall_status": { "type": "string", "minLength": 1 },
    "tested_count": { "type": "integer", "minimum": 0 },
    "hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hook_id", "status"],
        "properties": {
          "hook_id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "detail": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
