{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory_status_report.schema.json",
  "title": "MemoryStatusReport",
  "type": "object",
  "required": [
    "schema_version",
    "conformance_line",
    "canonical_path",
    "retention_policy",
    "atomic_write_policy",
    "limit",
    "active_count",
    "pinned_count",
    "evicted_count",
    "append_log_count",
    "promotion_queue_count",
    "durable_status",
    "durable_count",
    "durable_injectable_count",
    "durable_invalidated_count",
    "active_records",
    "evicted_record_ids"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "conformance_line": { "type": "string", "enum": ["M7.working_memory", "M8.memory_status"] },
    "canonical_path": { "type": "string", "minLength": 1 },
    "retention_policy": { "type": "string", "minLength": 1 },
    "atomic_write_policy": { "type": "string", "minLength": 1 },
    "limit": { "type": "integer", "minimum": 1 },
    "active_count": { "type": "integer", "minimum": 0 },
    "pinned_count": { "type": "integer", "minimum": 0 },
    "evicted_count": { "type": "integer", "minimum": 0 },
    "append_log_count": { "type": "integer", "minimum": 0 },
    "promotion_queue_count": { "type": "integer", "minimum": 0 },
    "durable_status": { "type": "string", "enum": ["available", "degraded"] },
    "durable_count": { "type": "integer", "minimum": 0 },
    "durable_injectable_count": { "type": "integer", "minimum": 0 },
    "durable_invalidated_count": { "type": "integer", "minimum": 0 },
    "active_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "conformance_line",
          "canonical_path",
          "retention_policy",
          "atomic_write_policy",
          "record_id",
          "kind",
          "content",
          "support_refs",
          "pinned",
          "status",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "schema_version": { "type": "string", "minLength": 1 },
          "conformance_line": { "type": "string", "const": "M7.working_memory" },
          "canonical_path": { "type": "string", "minLength": 1 },
          "retention_policy": { "type": "string", "minLength": 1 },
          "atomic_write_policy": { "type": "string", "minLength": 1 },
          "record_id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "content": { "type": "string", "minLength": 1 },
          "support_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "pinned": { "type": "boolean" },
          "status": { "type": "string", "enum": ["active", "evicted"] },
          "created_at": { "type": "string", "minLength": 1 },
          "updated_at": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "evicted_record_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
