{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile_resolution_trace.schema.json",
  "title": "ProfileResolutionTrace",
  "type": "object",
  "required": ["resolved_profile", "source"],
  "properties": {
    "requested_profile": { "type": "string" },
    "resolved_profile": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "inherited_scopes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
