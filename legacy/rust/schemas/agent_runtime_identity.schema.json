{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_runtime_identity.schema.json",
  "title": "AgentRuntimeIdentity",
  "type": "object",
  "required": [
    "schema_version",
    "runtime_id",
    "agent_id",
    "runtime_kind",
    "role_kind",
    "role_profile",
    "runner_kind",
    "authority_scope",
    "lifecycle_status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "runtime_id": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string", "minLength": 1 },
    "runtime_kind": { "type": "string", "minLength": 1 },
    "role_kind": { "type": "string", "minLength": 1 },
    "role_profile": { "type": "string", "minLength": 1 },
    "runner_kind": { "type": "string", "minLength": 1 },
    "authority_scope": { "type": "string", "minLength": 1 },
    "lifecycle_status": { "type": "string", "minLength": 1 },
    "session_ref": { "type": "string", "minLength": 1 },
    "task_packet_ref": { "type": "string", "minLength": 1 },
    "output_manifest_ref": { "type": "string", "minLength": 1 },
    "provider_id": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "trace_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "tool_scope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
