{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project_inspection.schema.json",
  "title": "ProjectInspection",
  "type": "object",
  "required": [
    "project_id",
    "registry_entry",
    "init_state",
    "degraded_features",
    "section_status"
  ],
  "properties": {
    "project_id": { "type": "string", "minLength": 1 },
    "registry_entry": { "type": "object" },
    "init_state": { "type": "string", "minLength": 1 },
    "active_session_id": { "type": ["string", "null"] },
    "project_continuity": { "type": "object" },
    "degraded_features": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "section_status": {
      "type": "object",
      "required": [
        "projectops",
        "memory",
        "branches",
        "reviews",
        "active_runs",
        "cleanup",
        "canonicality"
      ],
      "properties": {
        "projectops": { "type": "string", "const": "available" },
        "memory": { "type": "string", "minLength": 1 },
        "branches": { "type": "string", "const": "guarded" },
        "reviews": { "type": "string", "const": "available" },
        "active_runs": { "type": "string", "minLength": 1 },
        "cleanup": { "type": "string", "const": "available" },
        "canonicality": { "type": "string", "const": "available" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
