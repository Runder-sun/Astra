{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tailscale_status_report.schema.json",
  "title": "TailscaleStatusReport",
  "type": "object",
  "required": [
    "schema_version",
    "overlay_detected",
    "detection_source",
    "addresses",
    "suggested_bind_host",
    "network_cidr"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "overlay_detected": { "type": "boolean" },
    "detection_source": { "type": "string", "minLength": 1 },
    "addresses": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "suggested_bind_host": { "type": "string", "minLength": 1 },
    "network_cidr": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
