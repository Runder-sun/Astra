{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research_debate_trace.schema.json",
  "title": "ResearchDebateTrace",
  "type": "object",
  "required": [
    "schema_version",
    "conformance_line",
    "trace_id",
    "packet_id",
    "thread_id",
    "stage_execution_id",
    "reviewer_roles",
    "recommendation",
    "unresolved_assumptions",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "research_debate_trace.v1" },
    "conformance_line": { "const": "M10.research_runtime" },
    "trace_id": { "type": "string", "minLength": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "thread_id": { "type": "string", "minLength": 1 },
    "stage_execution_id": { "type": "string", "minLength": 1 },
    "reviewer_roles": {
      "type": "array",
      "items": { "enum": ["critic", "tester", "director"] },
      "minItems": 1
    },
    "recommendation": { "type": "string", "minLength": 1 },
    "unresolved_assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "created_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
