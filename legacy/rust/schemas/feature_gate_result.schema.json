{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feature_gate_result.schema.json",
  "title": "FeatureGateResult",
  "type": "object",
  "required": [
    "feature_id",
    "requested_command",
    "gate_state",
    "milestone",
    "next_steps"
  ],
  "properties": {
    "feature_id": {
      "type": "string",
      "minLength": 1
    },
    "requested_command": {
      "type": "string",
      "minLength": 1
    },
    "gate_state": {
      "type": "string",
      "enum": ["not_graduated"]
    },
    "milestone": {
      "type": "string",
      "minLength": 1
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
