{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "debate_trace.schema.json",
  "title": "DebateTrace",
  "type": "object",
  "required": [
    "schema_version",
    "conformance_line",
    "debate_id",
    "branch_id",
    "against_branch_id",
    "proposition",
    "supporting_evidence",
    "opposing_evidence",
    "unresolved_assumptions",
    "reviewer_roles",
    "recommendation",
    "confidence",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "debate_trace.v1" },
    "conformance_line": { "const": "M9.branch_debate" },
    "debate_id": { "type": "string", "minLength": 1 },
    "branch_id": { "type": "string", "minLength": 1 },
    "against_branch_id": { "type": "string", "minLength": 1 },
    "proposition": { "type": "string", "minLength": 1 },
    "supporting_evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "opposing_evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "unresolved_assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "reviewer_roles": {
      "type": "array",
      "items": { "enum": ["critic", "tester", "director"] },
      "minItems": 1
    },
    "recommendation": { "enum": ["promotable_after_evaluation", "reject", "needs_revision"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "created_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
