{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hitl_pending_gate.schema.json",
  "title": "HitlPendingGate",
  "type": "object",
  "required": [
    "schema_version",
    "conformance_line",
    "gate_id",
    "thread_id",
    "stage_execution_id",
    "kind",
    "question",
    "options",
    "resume_policy",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "hitl_pending_gate.v1" },
    "conformance_line": { "const": "M13.research_ux_middleware" },
    "gate_id": { "type": "string", "minLength": 1 },
    "thread_id": { "type": "string", "minLength": 1 },
    "stage_execution_id": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["clarification", "approval", "recovery"] },
    "question": { "type": "string", "minLength": 1 },
    "options": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "resume_policy": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pending", "answered", "cancelled", "expired"] },
    "created_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
