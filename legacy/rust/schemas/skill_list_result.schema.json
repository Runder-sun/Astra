{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill_list_result.schema.json",
  "title": "SkillListResult",
  "type": "object",
  "required": ["search_paths", "skills", "total_count", "degraded_count"],
  "properties": {
    "search_paths": { "$ref": "#/$defs/stringArray" },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/skillRegistryEntry" }
    },
    "total_count": { "type": "integer", "minimum": 0 },
    "degraded_count": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "skillRegistryEntry": {
      "type": "object",
      "required": [
        "skill_id",
        "description",
        "manifest_path",
        "source",
        "enabled",
        "degraded"
      ],
      "properties": {
        "skill_id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "manifest_path": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "degraded": { "type": "boolean" },
        "disabled_reason": { "type": "string", "minLength": 1 },
        "stage_compatibility": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
