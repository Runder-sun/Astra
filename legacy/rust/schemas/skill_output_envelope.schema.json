{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill_output_envelope.schema.json",
  "title": "SkillOutputEnvelope",
  "type": "object",
  "required": [
    "schema_version",
    "envelope_id",
    "skill_id",
    "skill_version",
    "output_kind",
    "visibility",
    "artifact_family",
    "artifact_refs",
    "canonicality_policy",
    "human_gate_required",
    "supersedes",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "envelope_id": { "type": "string", "minLength": 1 },
    "skill_id": { "type": "string", "minLength": 1 },
    "skill_version": { "type": "string", "minLength": 1 },
    "thread_id": { "type": "string", "minLength": 1 },
    "stage_execution_id": { "type": "string", "minLength": 1 },
    "operation": { "type": "string", "minLength": 1 },
    "output_kind": { "type": "string", "minLength": 1 },
    "visibility": { "enum": ["review_candidate", "canonical_public", "superseded"] },
    "artifact_family": { "type": "string", "minLength": 1 },
    "artifact_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_id", "artifact_path", "artifact_kind"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "artifact_path": { "type": "string", "minLength": 1 },
          "artifact_kind": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "doc_frame_candidate": { "type": "object" },
    "canonicality_policy": { "type": "string", "minLength": 1 },
    "human_gate_required": { "type": "boolean" },
    "review_packet_ref": { "type": "string", "minLength": 1 },
    "change_envelope_ref": { "type": "string", "minLength": 1 },
    "supersedes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "created_at": { "type": "string", "minLength": 1 },
    "published_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
