{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "followup_required_result.schema.json",
  "title": "FollowupRequiredResult",
  "type": "object",
  "required": ["followup_kind", "reason_code", "message"],
  "properties": {
    "followup_kind": { "type": "string", "minLength": 1 },
    "reason_code": { "type": "string", "minLength": 1 },
    "message": { "type": "string", "minLength": 1 },
    "required_inputs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "next_steps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": true
}
