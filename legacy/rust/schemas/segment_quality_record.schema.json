{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "segment_quality_record.schema.json",
  "title": "SegmentQualityRecord",
  "type": "object",
  "required": [
    "schema_version",
    "conformance_line",
    "canonical_path",
    "retention_policy",
    "atomic_write_policy",
    "quality_id",
    "segment_id",
    "provider",
    "model",
    "criteria",
    "overall_score",
    "memory_eligible",
    "failure_reason",
    "evidence_refs",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "trajectory.segment_quality.v1" },
    "conformance_line": { "type": "string", "const": "M15.segment_quality" },
    "canonical_path": { "type": "string", "minLength": 1 },
    "retention_policy": { "type": "string", "minLength": 1 },
    "atomic_write_policy": { "type": "string", "minLength": 1 },
    "quality_id": { "type": "string", "minLength": 1 },
    "segment_id": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "criteria": {
      "type": "object",
      "required": [
        "task_completion",
        "evidence_density",
        "artifact_linkage",
        "contradiction_risk",
        "privacy_risk",
        "reuse_value"
      ],
      "properties": {
        "task_completion": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_density": { "type": "number", "minimum": 0, "maximum": 1 },
        "artifact_linkage": { "type": "number", "minimum": 0, "maximum": 1 },
        "contradiction_risk": { "type": "number", "minimum": 0, "maximum": 1 },
        "privacy_risk": { "type": "number", "minimum": 0, "maximum": 1 },
        "reuse_value": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "overall_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "memory_eligible": { "type": "boolean" },
    "failure_reason": { "type": "string" },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "created_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
