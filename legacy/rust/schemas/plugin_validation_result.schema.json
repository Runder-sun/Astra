{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin_validation_result.schema.json",
  "title": "PluginValidationResult",
  "type": "object",
  "required": ["scope", "overall_status", "validated_count"],
  "properties": {
    "scope": { "type": "string", "minLength": 1 },
    "overall_status": { "type": "string", "minLength": 1 },
    "validated_count": { "type": "integer", "minimum": 0 },
    "degraded_plugin_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["plugin_id", "severity", "message"],
        "properties": {
          "plugin_id": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
