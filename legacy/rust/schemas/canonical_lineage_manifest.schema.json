{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canonical_lineage_manifest.schema.json",
  "title": "CanonicalLineageManifest",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "current_generation",
    "policy",
    "nodes"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "current_generation": { "type": "string", "minLength": 1 },
    "policy": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "artifact_id",
        "family",
        "role",
        "path",
        "status",
        "generation",
        "derived_from",
        "evidence_refs"
      ],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "role": { "type": "string" },
        "path": { "type": "string" },
        "status": { "type": "string", "minLength": 1 },
        "generation": { "type": "string" },
        "derived_from": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
