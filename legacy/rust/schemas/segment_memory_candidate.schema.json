{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "segment_memory_candidate.schema.json",
  "title": "SegmentMemoryCandidate",
  "type": "object",
  "required": [
    "schema_version",
    "conformance_line",
    "canonical_path",
    "retention_policy",
    "atomic_write_policy",
    "candidate_id",
    "segment_id",
    "ingest_id",
    "project_id",
    "title",
    "summary",
    "body",
    "memory_kind",
    "support_refs",
    "source_artifacts",
    "source_artifact_path",
    "segment_tag",
    "quality_id",
    "promotion_status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "trajectory.memory_candidate.v1" },
    "conformance_line": { "type": "string", "const": "M15.segment_memory_candidate" },
    "canonical_path": { "type": "string", "minLength": 1 },
    "retention_policy": { "type": "string", "minLength": 1 },
    "atomic_write_policy": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "segment_id": { "type": "string", "minLength": 1 },
    "ingest_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "body": { "type": "string", "minLength": 1 },
    "memory_kind": { "type": "string", "minLength": 1 },
    "support_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "source_artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "source_artifact_path": { "type": "string" },
    "segment_tag": { "type": "string", "minLength": 1 },
    "quality_id": { "type": "string", "minLength": 1 },
    "promotion_status": { "type": "string", "enum": ["queued", "promoted", "rejected", "invalidated"] },
    "session_id": { "type": "string" },
    "summary_ref": { "type": "string" },
    "status": { "type": "string" },
    "confidence": { "type": "string" },
    "degraded_reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "promotes_to_durable_memory": { "type": "boolean" },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
