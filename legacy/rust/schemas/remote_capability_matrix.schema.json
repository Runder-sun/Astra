{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "remote_capability_matrix.schema.json",
  "title": "RemoteCapabilityMatrix",
  "type": "object",
  "required": [
    "schema_version",
    "machine",
    "project",
    "session"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "machine": {
      "$ref": "#/$defs/remote_capability_set"
    },
    "project": {
      "$ref": "#/$defs/remote_capability_set"
    },
    "session": {
      "$ref": "#/$defs/remote_capability_set"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "remote_capability_set": {
      "title": "RemoteCapabilitySet",
      "type": "object",
      "required": [
        "schema_version",
        "scope",
        "capabilities"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  }
}
