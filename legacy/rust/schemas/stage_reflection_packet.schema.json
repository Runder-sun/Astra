{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage_reflection_packet.schema.json",
  "title": "StageReflectionPacket",
  "type": "object",
  "required": [
    "schema_version",
    "conformance_line",
    "packet_id",
    "thread_id",
    "stage_execution_id",
    "role_id",
    "intent_summary",
    "completed",
    "unmet_success_signals",
    "skill_suggestions",
    "stage_modifications",
    "new_stages",
    "todo_updates",
    "next_action",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "stage_reflection_packet.v1" },
    "conformance_line": { "const": "M13.research_ux_middleware" },
    "packet_id": { "type": "string", "minLength": 1 },
    "thread_id": { "type": "string", "minLength": 1 },
    "stage_execution_id": { "type": "string", "minLength": 1 },
    "role_id": { "type": "string", "minLength": 1 },
    "intent_summary": { "type": "string", "minLength": 1 },
    "completed": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "unmet_success_signals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "skill_suggestions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "stage_modifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage", "change"],
        "properties": {
          "stage": { "type": "string", "minLength": 1 },
          "change": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "new_stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "goal", "success_signals", "what_to_run", "expected_artifacts"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "goal": { "type": "string", "minLength": 1 },
          "success_signals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "what_to_run": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "expected_artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "todo_updates": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "next_action": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
