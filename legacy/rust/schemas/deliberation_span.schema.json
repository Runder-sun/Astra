{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deliberation_span.schema.json",
  "title": "DeliberationSpan",
  "type": "object",
  "required": [
    "schema_version",
    "conformance_line",
    "span_id",
    "thread_id",
    "stage_execution_id",
    "mode",
    "turn_refs",
    "evidence_refs",
    "open_questions",
    "candidate_options",
    "rejected_options",
    "agreed_decisions",
    "review_findings",
    "pending_operations",
    "next_recommended_action",
    "confidence",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "deliberation_span.v1" },
    "conformance_line": { "const": "M10.research_runtime" },
    "span_id": { "type": "string", "minLength": 1 },
    "thread_id": { "type": "string", "minLength": 1 },
    "stage_execution_id": { "type": "string", "minLength": 1 },
    "mode": {
      "enum": [
        "exploring",
        "comparing",
        "reviewing",
        "debugging",
        "interpreting_results",
        "drafting",
        "awaiting_human_gate",
        "ready_to_record",
        "ready_to_execute"
      ]
    },
    "turn_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "open_questions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "candidate_options": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "rejected_options": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "agreed_decisions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "review_findings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "pending_operations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "next_recommended_action": { "type": "string", "minLength": 1 },
    "confidence": { "enum": ["low", "medium", "high"] },
    "updated_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
