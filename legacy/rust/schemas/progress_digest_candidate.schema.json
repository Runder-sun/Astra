{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "progress_digest_candidate.schema.json",
  "title": "ProgressDigestCandidate",
  "type": "object",
  "required": [
    "schema_version",
    "conformance_line",
    "canonical_path",
    "retention_policy",
    "atomic_write_policy",
    "candidate_id",
    "tick_id",
    "project_id",
    "session_id",
    "summary_ref",
    "source_artifact_path",
    "status",
    "support_refs",
    "confidence",
    "degraded_reasons",
    "promotes_to_durable_memory",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "conformance_line": { "type": "string", "const": "M7.digest_candidate" },
    "canonical_path": { "type": "string", "minLength": 1 },
    "retention_policy": { "type": "string", "minLength": 1 },
    "atomic_write_policy": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "tick_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "summary_ref": { "type": "string", "minLength": 1 },
    "source_artifact_path": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["pending_review", "rejected", "contested", "promoted"] },
    "support_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "confidence": { "type": "string", "minLength": 1 },
    "degraded_reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "promotes_to_durable_memory": { "type": "boolean" },
    "created_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
