{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "debate_packet.schema.json",
  "title": "DebatePacket",
  "type": "object",
  "required": [
    "schema_version",
    "conformance_line",
    "packet_id",
    "thread_id",
    "stage_execution_id",
    "proposition",
    "candidate_options",
    "evidence_refs",
    "reviewer_roles",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "debate_packet.v1" },
    "conformance_line": { "const": "M10.research_runtime" },
    "packet_id": { "type": "string", "minLength": 1 },
    "thread_id": { "type": "string", "minLength": 1 },
    "stage_execution_id": { "type": "string", "minLength": 1 },
    "proposition": { "type": "string", "minLength": 1 },
    "candidate_options": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "reviewer_roles": {
      "type": "array",
      "items": { "enum": ["critic", "tester", "director"] },
      "minItems": 1
    },
    "created_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
