{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill_docframe_publication.schema.json",
  "title": "SkillDocFramePublication",
  "type": "object",
  "required": [
    "schema_version",
    "conformance_line",
    "envelope_id",
    "artifact_family",
    "doc_frame_ref",
    "publication_policy",
    "publication_state",
    "canonical_surface_path"
  ],
  "properties": {
    "schema_version": { "const": "skill_docframe_publication.v1" },
    "conformance_line": { "const": "M11.skill_publication" },
    "envelope_id": { "type": "string", "minLength": 1 },
    "artifact_family": { "type": "string", "minLength": 1 },
    "doc_frame_ref": { "type": "string", "minLength": 1 },
    "publication_policy": {
      "enum": [
        "private_only",
        "candidate_only",
        "requires_review",
        "winner_only_public_surface"
      ]
    },
    "publication_state": {
      "enum": ["candidate", "public_latest", "superseded"]
    },
    "canonical_surface_path": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
