{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project_registry_entry.schema.json",
  "title": "ProjectRegistryEntry",
  "type": "object",
  "required": [
    "project_id",
    "workspace_root",
    "workspace_hash",
    "data_dir",
    "last_accessed_at",
    "init_state",
    "active_session_id",
    "open_branch_count",
    "repo_health"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_root": {
      "type": "string",
      "minLength": 1
    },
    "workspace_hash": {
      "type": "string",
      "minLength": 1
    },
    "data_dir": {
      "type": "string",
      "minLength": 1
    },
    "last_accessed_at": {
      "type": "string",
      "minLength": 1
    },
    "init_state": {
      "type": "string",
      "minLength": 1
    },
    "active_session_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "open_branch_count": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "repo_health": {
      "type": ["string", "null"],
      "minLength": 1
    }
  },
  "additionalProperties": false
}
