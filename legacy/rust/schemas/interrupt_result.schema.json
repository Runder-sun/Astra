{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interrupt_result.schema.json",
  "title": "InterruptResult",
  "type": "object",
  "required": ["session_id", "turn_id", "interrupt_id", "status", "checkpoint_ref"],
  "properties": {
    "session_id": { "type": "string", "minLength": 1 },
    "turn_id": { "type": "string", "minLength": 1 },
    "interrupt_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "checkpoint_ref": { "type": "string", "minLength": 1 },
    "safe_retry": { "type": "boolean" },
    "reason": { "type": "string" }
  },
  "additionalProperties": false
}
