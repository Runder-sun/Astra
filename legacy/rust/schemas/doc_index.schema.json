{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doc_index.schema.json",
  "title": "DocIndex",
  "type": "object",
  "required": [
    "index_id",
    "project_id",
    "generated_at",
    "doc_frames",
    "invalid_docs",
    "missing_required_frames",
    "stale_frames",
    "mission_frame_candidates",
    "total_count",
    "invalid_count",
    "missing_required_frames_count",
    "stale_count"
  ],
  "properties": {
    "index_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "doc_frames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "doc_id",
          "schema_version",
          "source_path",
          "title",
          "doc_type",
          "lifecycle",
          "scope",
          "summary",
          "generated_by",
          "updated_at"
        ],
        "properties": {
          "doc_id": { "type": "string", "minLength": 1 },
          "schema_version": { "type": "string", "minLength": 1 },
          "source_path": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "doc_type": { "type": "string", "minLength": 1 },
          "lifecycle": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 },
          "milestone": { "type": "string" },
          "summary": { "type": "string", "minLength": 1 },
          "key_claims": {
            "type": "array",
            "items": { "type": "string" }
          },
          "decisions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "interfaces": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "next_actions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "non_goals": {
            "type": "array",
            "items": { "type": "string" }
          },
          "generated_by": { "type": "string", "minLength": 1 },
          "updated_at": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "invalid_docs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_path", "reason"],
        "properties": {
          "source_path": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "missing_required_frames": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "stale_frames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_path", "reason"],
        "properties": {
          "source_path": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "mission_frame_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "source_doc_ids", "summary"],
        "properties": {
          "candidate_id": { "type": "string", "minLength": 1 },
          "source_doc_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "summary": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "total_count": { "type": "integer", "minimum": 0 },
    "invalid_count": { "type": "integer", "minimum": 0 },
    "missing_required_frames_count": { "type": "integer", "minimum": 0 },
    "stale_count": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
