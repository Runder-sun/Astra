{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "branch_run_record.schema.json",
  "title": "BranchRunRecord",
  "type": "object",
  "required": [
    "schema_version",
    "conformance_line",
    "branch_id",
    "batch_id",
    "parent_branch_id",
    "base_commit",
    "worktree_path",
    "hypothesis",
    "variation_operator",
    "agent_role",
    "claimed_paths",
    "status",
    "evaluation_id",
    "debate_trace_id",
    "verifier_tournament_id",
    "promotion_decision_id",
    "archived_reason",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "branch_run_record.v1" },
    "conformance_line": { "const": "M9.evolutionary_branch_intelligence" },
    "branch_id": { "type": "string", "minLength": 1 },
    "batch_id": { "type": "string", "minLength": 1 },
    "parent_branch_id": { "type": ["string", "null"] },
    "base_commit": { "type": "string" },
    "worktree_path": { "type": "string", "minLength": 1 },
    "hypothesis": { "type": "string", "minLength": 1 },
    "variation_operator": {
      "enum": [
        "mutate_patch",
        "repair_failure",
        "expand_tests",
        "simplify_diff",
        "crossover_branches",
        "rebase_refresh",
        "doc_canonicalize",
        "manual_candidate"
      ]
    },
    "agent_role": {
      "enum": [
        "search_worker",
        "debugger",
        "tester",
        "maintainer",
        "synthesizer",
        "integrator",
        "documentarian"
      ]
    },
    "claimed_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "status": {
      "enum": [
        "draft",
        "mutated",
        "evaluated",
        "needs_refresh",
        "debated",
        "promotable",
        "promoted",
        "archived"
      ]
    },
    "evaluation_id": { "type": ["string", "null"] },
    "debate_trace_id": { "type": ["string", "null"] },
    "verifier_tournament_id": { "type": ["string", "null"] },
    "promotion_decision_id": { "type": ["string", "null"] },
    "archived_reason": { "type": ["string", "null"] },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
