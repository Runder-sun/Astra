{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "remote_terminal_projection.schema.json",
  "title": "RemoteTerminalProjection",
  "type": "object",
  "required": [
    "schema_version",
    "terminal_id",
    "project_id",
    "lease_state",
    "lane_state",
    "authority",
    "owner_id",
    "control_lease_id",
    "input_policy",
    "resize_policy",
    "signal_policy",
    "scrollback_cursor",
    "mobile_extra_keys",
    "xterm_bridge_state"
  ],
  "properties": {
    "schema_version": { "const": "governed_terminal_projection.v1" },
    "terminal_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "lease_state": { "type": "string", "enum": ["active", "inactive", "revoked"] },
    "lane_state": { "const": "governed_pty_projection" },
    "authority": { "const": "control_lease_required" },
    "owner_id": { "type": "string", "minLength": 1 },
    "control_lease_id": { "type": "string", "minLength": 1 },
    "active_session_id": { "type": ["string", "null"], "minLength": 1 },
    "input_policy": { "const": "typed_action_then_pty_bytes" },
    "resize_policy": { "const": "capture_resize_events" },
    "signal_policy": { "const": "allow_interrupt_through_control_gate" },
    "scrollback_cursor": { "type": "string", "minLength": 1 },
    "mobile_extra_keys": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "xterm_bridge_state": { "const": "host_pty_byte_stream" }
  },
  "additionalProperties": false
}
