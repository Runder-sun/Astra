{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill_availability_record.schema.json",
  "title": "SkillAvailabilityRecord",
  "type": "object",
  "required": [
    "skill_id",
    "enabled",
    "degraded",
    "disabled_reason",
    "stage_compatibility",
    "dependency_health",
    "manifest_path"
  ],
  "properties": {
    "skill_id": { "type": "string", "minLength": 1 },
    "enabled": { "type": "boolean" },
    "degraded": { "type": "boolean" },
    "disabled_reason": { "type": "string" },
    "stage_compatibility": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "dependency_health": { "enum": ["ready", "degraded"] },
    "manifest_path": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
