{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool_selection_trace.schema.json",
  "title": "ToolSelectionTrace",
  "type": "object",
  "required": [
    "schema_version",
    "conformance_line",
    "selection_id",
    "role_id",
    "requested_tools",
    "candidate_tools",
    "selected_tools",
    "filtered_tools",
    "always_include_tools",
    "selection_strategy",
    "fallback_reason",
    "authority_ceiling",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "tool_selection_trace.v1" },
    "conformance_line": { "const": "M13.research_ux_middleware" },
    "selection_id": { "type": "string", "minLength": 1 },
    "role_id": { "type": "string", "minLength": 1 },
    "requested_tools": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "candidate_tools": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "selected_tools": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "filtered_tools": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "always_include_tools": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "selection_strategy": { "type": "string", "minLength": 1 },
    "fallback_reason": { "type": ["string", "null"] },
    "authority_ceiling": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
