{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session_inspection.schema.json",
  "title": "SessionInspection",
  "type": "object",
  "required": [
    "session_id",
    "session",
    "recap",
    "lineage",
    "transcript_source",
    "operator_logs",
    "section_status"
  ],
  "properties": {
    "session_id": { "type": "string", "minLength": 1 },
    "session": { "$ref": "session_identity.schema.json" },
    "recap": { "type": "object" },
    "lineage": {
      "type": "array",
      "items": { "$ref": "session_lineage.schema.json" }
    },
    "provider_source": { "type": ["object", "null"] },
    "transcript_source": { "type": "object" },
    "operator_logs": {
      "type": "array",
      "items": { "type": "object" }
    },
    "section_status": { "type": "object" }
  },
  "additionalProperties": false
}
