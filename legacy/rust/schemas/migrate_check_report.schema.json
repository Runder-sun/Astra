{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "migrate_check_report.schema.json",
  "title": "MigrateCheckReport",
  "type": "object",
  "required": ["overall_status", "checked_roots", "pending_migrations", "incompatible"],
  "properties": {
    "overall_status": { "type": "string", "minLength": 1 },
    "checked_roots": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "pending_migrations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "incompatible": { "type": "boolean" }
  },
  "additionalProperties": false
}
