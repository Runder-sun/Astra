{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "goal_alignment_trace.schema.json",
  "title": "GoalAlignmentTrace",
  "type": "object",
  "required": [
    "trace_id",
    "project_id",
    "session_id",
    "command",
    "mission_frame_ref",
    "alignment_status",
    "alignment_method",
    "evidence_label",
    "mission_frame_present",
    "project_goal_supported",
    "milestone_goal_supported",
    "implementation_goal_supported",
    "support_scores",
    "checked_goals",
    "drift_reasons",
    "drift_risks",
    "evidence_refs",
    "recommended_next_action"
  ],
  "properties": {
    "trace_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "command": { "type": "string", "minLength": 1 },
    "mission_frame_ref": { "type": "string" },
    "alignment_status": {
      "type": "string",
      "enum": ["aligned", "drift_risk", "mission_frame_missing", "needs_review"]
    },
    "alignment_method": { "type": "string", "minLength": 1 },
    "evidence_label": { "type": "string", "minLength": 1 },
    "mission_frame_present": { "type": "boolean" },
    "project_goal_supported": { "type": "boolean" },
    "milestone_goal_supported": { "type": "boolean" },
    "implementation_goal_supported": { "type": "boolean" },
    "support_scores": {
      "type": "object",
      "required": [
        "project_max_goal",
        "milestone_goal",
        "current_implementation_goal"
      ],
      "properties": {
        "project_max_goal": { "type": "number", "minimum": 0, "maximum": 1 },
        "milestone_goal": { "type": "number", "minimum": 0, "maximum": 1 },
        "current_implementation_goal": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "checked_goals": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "enum": [
          "project_max_goal",
          "milestone_goal",
          "current_implementation_goal"
        ]
      }
    },
    "drift_reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "drift_risks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "recommended_next_action": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
