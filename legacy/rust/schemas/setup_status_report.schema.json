{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "setup_status_report.schema.json",
  "title": "SetupStatusReport",
  "type": "object",
  "required": [
    "overall_status",
    "state_home",
    "install_routes",
    "schema_versions",
    "data_directories",
    "last_migration"
  ],
  "properties": {
    "overall_status": { "type": "string", "minLength": 1 },
    "state_home": { "type": "string", "minLength": 1 },
    "install_routes": { "$ref": "#/$defs/installRoutesReport" },
    "schema_versions": {
      "type": "array",
      "items": { "$ref": "#/$defs/schemaVersion" }
    },
    "data_directories": {
      "type": "array",
      "items": { "$ref": "#/$defs/dataDirectoryStatus" }
    },
    "last_migration": { "$ref": "#/$defs/migrationStatus" }
  },
  "$defs": {
    "schemaVersion": {
      "type": "object",
      "required": ["schema", "version"],
      "properties": {
        "schema": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "dataDirectoryStatus": {
      "type": "object",
      "required": ["kind", "path", "exists"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "exists": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "migrationStatus": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "updated_at": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "installRoutesReport": {
      "type": "object",
      "required": [
        "platform",
        "state_home",
        "registry_root",
        "pmcli_root",
        "schema_root",
        "providers",
        "skills",
        "mcp",
        "plugins",
        "hooks",
        "remote"
      ],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "state_home": { "type": "string", "minLength": 1 },
        "registry_root": { "type": "string", "minLength": 1 },
        "pmcli_root": { "type": "string", "minLength": 1 },
        "schema_root": { "type": "string", "minLength": 1 },
        "providers": { "$ref": "#/$defs/stringArray" },
        "skills": { "$ref": "#/$defs/stringArray" },
        "mcp": { "$ref": "#/$defs/stringArray" },
        "plugins": { "$ref": "#/$defs/stringArray" },
        "hooks": { "$ref": "#/$defs/stringArray" },
        "remote": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
