{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory_adoption_event.schema.json",
  "title": "MemoryAdoptionEvent",
  "type": "object",
  "required": [
    "schema_version",
    "conformance_line",
    "canonical_path",
    "retention_policy",
    "atomic_write_policy",
    "event_id",
    "memory_record_id",
    "segment_id",
    "event_kind",
    "weight",
    "surface",
    "actor",
    "support_ref",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "memory.adoption_event.v1" },
    "conformance_line": { "type": "string", "const": "M15.memory_adoption" },
    "canonical_path": { "type": "string", "minLength": 1 },
    "retention_policy": { "type": "string", "minLength": 1 },
    "atomic_write_policy": { "type": "string", "minLength": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "memory_record_id": { "type": "string", "minLength": 1 },
    "segment_id": { "type": "string" },
    "event_kind": {
      "type": "string",
      "enum": ["retrieved", "inspected", "injected", "cited_in_output", "merged", "superseded", "invalidated", "rejected"]
    },
    "weight": { "type": "number" },
    "surface": { "type": "string", "minLength": 1 },
    "actor": { "type": "string", "minLength": 1 },
    "support_ref": { "type": "string" },
    "created_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
