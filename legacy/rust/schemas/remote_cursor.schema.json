{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "remote_cursor.schema.json",
  "title": "RemoteCursor",
  "type": "object",
  "required": ["schema_version", "cursor_id", "project_id", "cursor_state", "last_event_seq", "ownership_epoch", "replay_token", "replay_policy", "updated_at"],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "cursor_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "cursor_state": { "type": "string", "minLength": 1 },
    "last_event_seq": { "type": "integer", "minimum": 0 },
    "ownership_epoch": { "type": "integer", "minimum": 0 },
    "replay_token": { "type": "string", "minLength": 1 },
    "replay_policy": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
