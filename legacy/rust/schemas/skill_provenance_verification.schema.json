{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill_provenance_verification.schema.json",
  "title": "SkillProvenanceVerification",
  "type": "object",
  "required": ["schema_version", "conformance_line", "canonical_path", "retention_policy", "atomic_write_policy", "verification_id", "candidate_id", "grounded_claim_count", "hallucinated_claim_count", "contradicted_claim_count", "grounded_evidence_ratio", "decision", "evidence_refs", "created_at"],
  "properties": {
    "schema_version": { "const": "skill.provenance_verification.v1" },
    "conformance_line": { "const": "M16.skill_provenance_verification" },
    "canonical_path": { "type": "string", "minLength": 1 },
    "retention_policy": { "type": "string", "minLength": 1 },
    "atomic_write_policy": { "type": "string", "minLength": 1 },
    "verification_id": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "grounded_claim_count": { "type": "integer", "minimum": 0 },
    "hallucinated_claim_count": { "type": "integer", "minimum": 0 },
    "contradicted_claim_count": { "type": "integer", "minimum": 0 },
    "grounded_evidence_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "decision": { "enum": ["verified", "rejected"] },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "created_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
