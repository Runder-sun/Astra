{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review_list_result.schema.json",
  "title": "ReviewListResult",
  "type": "object",
  "required": ["reviews", "total_count"],
  "properties": {
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "review_id",
          "objective",
          "reviewer_role",
          "review_model",
          "target_count",
          "status",
          "verdict",
          "packet_path",
          "latest_trace_path",
          "updated_at"
        ],
        "properties": {
          "review_id": { "type": "string", "minLength": 1 },
          "objective": { "type": "string", "minLength": 1 },
          "reviewer_role": { "type": "string", "minLength": 1 },
          "review_model": { "type": "string", "minLength": 1 },
          "target_count": { "type": "integer", "minimum": 0 },
          "status": { "type": "string", "minLength": 1 },
          "verdict": { "type": "string", "minLength": 1 },
          "packet_path": { "type": "string", "minLength": 1 },
          "latest_trace_path": { "type": "string", "minLength": 1 },
          "updated_at": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "total_count": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
