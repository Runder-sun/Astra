{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact_promotion_queue_result.schema.json",
  "title": "ArtifactPromotionQueueResult",
  "type": "object",
  "required": ["candidates", "total_count"],
  "properties": {
    "candidates": {
      "type": "array",
      "items": { "$ref": "artifact_promotion_candidate.schema.json" }
    },
    "total_count": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
