{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tui_launch_result.schema.json",
  "title": "TuiLaunchResult",
  "type": "object",
  "required": [
    "schema_version",
    "launch_mode",
    "runtime",
    "projection",
    "inline_view",
    "degradation_policy"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "tui_launch_result.v1" },
    "launch_mode": {
      "enum": [
        "inline_projection_renderer",
        "fullscreen_split_pane_projection_renderer"
      ]
    },
    "runtime": { "const": "projection_first_terminal_contract" },
    "projection": { "type": "object" },
    "inline_view": { "$ref": "#/$defs/inline_view" },
    "degradation_policy": {
      "const": "fallback_to_json_snapshot_on_unsupported_terminal"
    }
  },
  "$defs": {
    "inline_view": {
      "type": "object",
      "required": [
        "schema_version",
        "renderer_mode",
        "layout",
        "authority_model",
        "capabilities",
        "command_model",
        "skill_model",
        "status_hud",
        "pane_plans",
        "keymap",
        "theme"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "tui_inline_view.v1" },
        "renderer_mode": {
          "enum": ["inline_terminal", "alternate_screen_split_pane"]
        },
        "layout": {
          "enum": [
            "single_column_with_collapsible_panes",
            "fullscreen_split_pane_with_sidebar",
            "chat_first_repl",
            "advanced_fullscreen_chat_first"
          ]
        },
        "authority_model": { "const": "kernel_authoritative_projection" },
        "capabilities": {
          "type": "array",
          "minItems": 8,
          "items": { "$ref": "#/$defs/capability" }
        },
        "command_model": { "$ref": "#/$defs/command_model" },
        "skill_model": { "$ref": "#/$defs/skill_model" },
        "status_hud": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/status_badge" }
        },
        "pane_plans": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/pane_plan" }
        },
        "keymap": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/key_binding" }
        },
        "theme": { "$ref": "#/$defs/theme" }
      }
    },
    "capability": {
      "type": "object",
      "required": ["capability_id", "status", "source"],
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "type": "string",
          "enum": [
            "status_hud",
            "markdown_renderer",
            "composer_text_entry",
            "slash_command_router",
            "skill_invocation_router",
            "collapsible_tool_output",
            "colored_diff",
            "internal_pager",
            "permission_overlay",
            "session_picker",
            "theme_selection"
          ]
        },
        "status": {
          "type": "string",
          "enum": ["available", "interactive", "projection_only"]
        },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "command_model": {
      "type": "object",
      "required": ["command_prefix", "groups"],
      "additionalProperties": false,
      "properties": {
        "command_prefix": { "const": "/" },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/command_group" }
        }
      }
    },
    "command_group": {
      "type": "object",
      "required": ["group_id", "label", "commands"],
      "additionalProperties": false,
      "properties": {
        "group_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/command_entry" }
        }
      }
    },
    "command_entry": {
      "type": "object",
      "required": ["typed", "action_id", "label", "summary", "gate"],
      "additionalProperties": false,
      "properties": {
        "typed": { "type": "string", "minLength": 1 },
        "action_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "gate": { "type": "string", "minLength": 1 }
      }
    },
    "skill_model": {
      "type": "object",
      "required": ["skill_prefix", "total_count", "degraded_count", "entries"],
      "additionalProperties": false,
      "properties": {
        "skill_prefix": { "const": "$" },
        "total_count": { "type": "integer", "minimum": 0 },
        "degraded_count": { "type": "integer", "minimum": 0 },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/skill_entry" }
        }
      }
    },
    "skill_entry": {
      "type": "object",
      "required": ["typed", "skill_id", "description", "enabled", "degraded", "source"],
      "additionalProperties": false,
      "properties": {
        "typed": { "type": "string", "pattern": "^\\$" },
        "skill_id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "degraded": { "type": "boolean" },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "status_badge": {
      "type": "object",
      "required": ["badge_id", "label", "state", "data_ref"],
      "additionalProperties": false,
      "properties": {
        "badge_id": {
          "type": "string",
          "enum": [
            "project",
            "remote",
            "sessions",
            "permissions",
            "permission_mode",
            "model",
            "reasoning",
            "theme"
          ]
        },
        "label": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 },
        "data_ref": { "type": "string", "minLength": 1 }
      }
    },
    "pane_plan": {
      "type": "object",
      "required": [
        "pane_id",
        "renderer",
        "collapse_state",
        "pager",
        "data_ref",
        "empty_state",
        "action_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "pane_id": { "type": "string", "minLength": 1 },
        "renderer": {
          "type": "string",
          "enum": [
            "markdown_message_list",
            "prompt_editor",
            "status_hud",
            "collapsible_tool_output",
            "modal_permission_overlay",
            "colored_diff_view",
            "memory_summary_table",
            "branch_review_table",
            "research_dag_timeline",
            "diagnostics_table",
            "json_projection_table"
          ]
        },
        "collapse_state": {
          "type": "string",
          "enum": ["expanded", "collapsed", "hidden"]
        },
        "pager": { "type": "string", "enum": ["internal_pager", "none"] },
        "data_ref": { "type": "string", "minLength": 1 },
        "empty_state": { "type": "string", "minLength": 1 },
        "action_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "key_binding": {
      "type": "object",
      "required": ["key", "action_id", "gate"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "action_id": { "type": "string", "minLength": 1 },
        "gate": { "type": "string", "minLength": 1 }
      }
    },
    "theme": {
      "type": "object",
      "required": ["theme_id", "mode", "supports_dark_light", "accent_source"],
      "additionalProperties": false,
      "properties": {
        "theme_id": { "enum": ["system_auto", "astra_research_cli", "light_default"] },
        "mode": {
          "enum": [
            "auto_dark_light",
            "light_default",
            "light_with_dark_available"
          ]
        },
        "supports_dark_light": { "const": true },
        "accent_source": {
          "enum": [
            "project_status_and_permission_state",
            "research_stage_and_permission_mode",
            "warm_orange_product_theme"
          ]
        }
      }
    }
  }
}
