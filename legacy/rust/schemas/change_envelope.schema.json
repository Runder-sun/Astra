{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "change_envelope.schema.json",
  "title": "ChangeEnvelope",
  "type": "object",
  "required": [
    "schema_version",
    "conformance_line",
    "envelope_id",
    "thread_id",
    "stage_execution_id",
    "operation",
    "decision_record",
    "mutation_class",
    "human_gate_required",
    "input_artifacts",
    "output_artifacts",
    "canonicality_action",
    "doc_frame_action",
    "doc_frame_ref",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "change_envelope.v1" },
    "conformance_line": { "const": "M10.research_runtime" },
    "envelope_id": { "type": "string", "minLength": 1 },
    "thread_id": { "type": "string", "minLength": 1 },
    "stage_execution_id": { "type": "string", "minLength": 1 },
    "operation": {
      "enum": [
        "advance",
        "retry",
        "repair",
        "pivot",
        "fork",
        "supersede",
        "abandon",
        "human_override"
      ]
    },
    "decision_record": { "type": ["string", "null"] },
    "mutation_class": { "type": "string", "minLength": 1 },
    "human_gate_required": { "type": "boolean" },
    "input_artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "output_artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "canonicality_action": { "type": "string", "minLength": 1 },
    "doc_frame_action": { "type": "string", "minLength": 1 },
    "doc_frame_ref": { "type": ["string", "null"] },
    "created_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
