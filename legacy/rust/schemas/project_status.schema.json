{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project_status.schema.json",
  "title": "ProjectStatus",
  "type": "object",
  "required": [
    "project_id",
    "workspace_root",
    "session_count",
    "resolution_source",
    "registry_entry",
    "init_state",
    "active_session_id",
    "open_branch_count",
    "repo_health",
    "degraded_features"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_root": {
      "type": "string",
      "minLength": 1
    },
    "session_count": {
      "type": "integer",
      "minimum": 0
    },
    "resolution_source": {
      "type": "string",
      "minLength": 1
    },
    "registry_entry": {
      "$ref": "#/$defs/projectRegistryEntry"
    },
    "init_state": {
      "type": "string",
      "minLength": 1
    },
    "active_session_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "open_branch_count": {
      "type": "integer",
      "minimum": 0
    },
    "repo_health": {
      "type": "string",
      "minLength": 1
    },
    "degraded_features": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "project_continuity": {
      "type": "object"
    }
  },
  "$defs": {
    "projectRegistryEntry": {
      "type": "object",
      "required": [
        "project_id",
        "workspace_root",
        "workspace_hash",
        "data_dir",
        "last_accessed_at",
        "init_state",
        "active_session_id",
        "open_branch_count",
        "repo_health"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "workspace_root": {
          "type": "string",
          "minLength": 1
        },
        "workspace_hash": {
          "type": "string",
          "minLength": 1
        },
        "data_dir": {
          "type": "string",
          "minLength": 1
        },
        "last_accessed_at": {
          "type": "string",
          "minLength": 1
        },
        "init_state": {
          "type": "string",
          "minLength": 1
        },
        "active_session_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "open_branch_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "repo_health": {
          "type": ["string", "null"],
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
