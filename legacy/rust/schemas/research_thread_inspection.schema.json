{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research_thread_inspection.schema.json",
  "title": "ResearchThreadInspection",
  "type": "object",
  "required": [
    "schema_version",
    "conformance_line",
    "thread",
    "stage_executions",
    "deliberation_spans",
    "decisions",
    "canonical_artifact_refs"
  ],
  "properties": {
    "schema_version": { "const": "research_thread_inspection.v1" },
    "conformance_line": { "const": "M10.research_runtime" },
    "thread": { "type": "object" },
    "stage_executions": { "type": "array", "items": { "type": "object" } },
    "deliberation_spans": { "type": "array", "items": { "type": "object" } },
    "decisions": { "type": "array", "items": { "type": "object" } },
    "canonical_artifact_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
