{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin_inspection_result.schema.json",
  "title": "PluginInspectionResult",
  "type": "object",
  "required": [
    "plugin_id",
    "manifest_origin",
    "manifest_path",
    "enabled",
    "hook_surface",
    "tool_additions",
    "config_source"
  ],
  "properties": {
    "plugin_id": { "type": "string", "minLength": 1 },
    "manifest_origin": { "type": "string", "minLength": 1 },
    "manifest_path": { "type": "string", "minLength": 1 },
    "enabled": { "type": "boolean" },
    "hook_surface": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "tool_additions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "config_source": { "type": "string", "minLength": 1 },
    "last_known_degraded_reason": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
