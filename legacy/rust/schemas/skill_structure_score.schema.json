{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill_structure_score.schema.json",
  "title": "SkillStructureScore",
  "type": "object",
  "required": ["schema_version", "conformance_line", "canonical_path", "retention_policy", "atomic_write_policy", "score_id", "candidate_id", "workflow_clarity", "specificity_and_reusability", "preserves_existing_value", "overall_score", "upgrade_decision", "created_at"],
  "properties": {
    "schema_version": { "const": "skill.structure_score.v1" },
    "conformance_line": { "const": "M16.skill_structure_score" },
    "canonical_path": { "type": "string", "minLength": 1 },
    "retention_policy": { "type": "string", "minLength": 1 },
    "atomic_write_policy": { "type": "string", "minLength": 1 },
    "score_id": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "workflow_clarity": { "type": "number", "minimum": 0, "maximum": 1 },
    "specificity_and_reusability": { "type": "number", "minimum": 0, "maximum": 1 },
    "preserves_existing_value": { "type": "number", "minimum": 0, "maximum": 1 },
    "overall_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "upgrade_decision": { "enum": ["upgrade_allowed", "upgrade_blocked"] },
    "created_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
