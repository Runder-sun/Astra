{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verifier_tournament.schema.json",
  "title": "VerifierTournament",
  "type": "object",
  "required": [
    "schema_version",
    "conformance_line",
    "tournament_id",
    "scope",
    "batch_id",
    "candidate_refs",
    "criteria",
    "repetitions",
    "pair_scores",
    "winner_ref",
    "recommendation",
    "deterministic_gate_result_ref",
    "canonicality_gate_result_ref",
    "merge_gate_result_ref",
    "advisory_until_gates_pass",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "verifier_tournament.v1" },
    "conformance_line": { "const": "M12.verifier_tournament" },
    "tournament_id": { "type": "string", "minLength": 1 },
    "scope": {
      "enum": ["branch_promotion", "research_decision", "claim_validation"]
    },
    "batch_id": { "type": "string", "minLength": 1 },
    "candidate_refs": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/verifier_criterion" }
    },
    "repetitions": { "type": "integer", "minimum": 1, "maximum": 20 },
    "pair_scores": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/verifier_pair_score" }
    },
    "winner_ref": { "type": "string", "minLength": 1 },
    "recommendation": {
      "enum": ["recommend_candidate_a", "recommend_candidate_b"]
    },
    "deterministic_gate_result_ref": { "type": ["string", "null"] },
    "canonicality_gate_result_ref": { "type": ["string", "null"] },
    "merge_gate_result_ref": { "type": ["string", "null"] },
    "advisory_until_gates_pass": { "const": true },
    "created_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "verifier_criterion": {
      "type": "object",
      "required": [
        "criterion_id",
        "name",
        "description",
        "evidence_requirements",
        "ground_truth_note"
      ],
      "properties": {
        "criterion_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "evidence_requirements": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "ground_truth_note": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "verifier_pair_score": {
      "type": "object",
      "required": [
        "schema_version",
        "conformance_line",
        "pair_score_id",
        "batch_id",
        "candidate_a",
        "candidate_b",
        "criterion_id",
        "repetition_index",
        "score_a",
        "score_b",
        "score_delta",
        "winner_ref",
        "provider",
        "model",
        "scoring_mode",
        "evidence_digest",
        "raw_trace_ref"
      ],
      "properties": {
        "schema_version": { "const": "verifier_pair_score.v1" },
        "conformance_line": { "const": "M12.verifier_tournament" },
        "pair_score_id": { "type": "string", "minLength": 1 },
        "batch_id": { "type": "string", "minLength": 1 },
        "candidate_a": { "type": "string", "minLength": 1 },
        "candidate_b": { "type": "string", "minLength": 1 },
        "criterion_id": { "type": "string", "minLength": 1 },
        "repetition_index": { "type": "integer", "minimum": 0 },
        "score_a": { "type": "number", "minimum": 0, "maximum": 1 },
        "score_b": { "type": "number", "minimum": 0, "maximum": 1 },
        "score_delta": { "type": "number", "minimum": -1, "maximum": 1 },
        "winner_ref": { "type": ["string", "null"] },
        "provider": { "enum": ["local", "openai", "gemini", "anthropic", "custom"] },
        "model": { "type": "string", "minLength": 1 },
        "scoring_mode": {
          "enum": [
            "deterministic_local_evidence",
            "score_token_logprob",
            "structured_llm_judge"
          ]
        },
        "evidence_digest": { "type": "string", "minLength": 1 },
        "raw_trace_ref": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
