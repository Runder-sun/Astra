{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session.schema.json",
  "title": "SessionTranscriptLine",
  "oneOf": [
    {
      "type": "object",
      "required": ["line_type", "event"],
      "properties": {
        "line_type": { "const": "control" },
        "event": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["line_type", "role", "content"],
      "properties": {
        "line_type": { "const": "message" },
        "role": { "type": "string", "minLength": 1 },
        "content": { "type": "string" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["line_type", "tool_name", "arguments"],
      "properties": {
        "line_type": { "const": "tool_call" },
        "tool_name": { "type": "string", "minLength": 1 },
        "arguments": { "type": "string" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["line_type", "tool_name", "output"],
      "properties": {
        "line_type": { "const": "tool_result" },
        "tool_name": { "type": "string", "minLength": 1 },
        "output": { "type": "string" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["line_type", "summary_ref"],
      "properties": {
        "line_type": { "const": "summary_reference" },
        "summary_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  ]
}
