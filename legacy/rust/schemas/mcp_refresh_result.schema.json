{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcp_refresh_result.schema.json",
  "title": "MCPRefreshResult",
  "type": "object",
  "required": ["refreshed_at", "search_paths", "servers", "total_count", "degraded_count"],
  "properties": {
    "refreshed_at": { "type": "string", "minLength": 1 },
    "search_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "servers": {
      "type": "array",
      "items": { "$ref": "#/$defs/serverEntry" }
    },
    "total_count": { "type": "integer", "minimum": 0 },
    "degraded_count": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "serverEntry": {
      "type": "object",
      "required": [
        "server_id",
        "transport",
        "tool_count",
        "auth_state",
        "status",
        "source",
        "manifest_path"
      ],
      "properties": {
        "server_id": { "type": "string", "minLength": 1 },
        "transport": { "type": "string", "minLength": 1 },
        "tool_count": { "type": "integer", "minimum": 0 },
        "auth_state": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "manifest_path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
