{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact_family.schema.json",
  "title": "ArtifactFamily",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_family",
    "canonical_id",
    "latest_id",
    "archive_ids",
    "supersession_chain",
    "source_branch_ids"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "artifact_family": { "type": "string", "minLength": 1 },
    "canonical_id": { "type": ["string", "null"] },
    "latest_id": { "type": ["string", "null"] },
    "archive_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "supersession_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_id", "to_id", "reason"],
        "properties": {
          "from_id": { "type": "string", "minLength": 1 },
          "to_id": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "source_branch_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
