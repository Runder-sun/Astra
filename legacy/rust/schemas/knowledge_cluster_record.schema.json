{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge_cluster_record.schema.json",
  "title": "KnowledgeClusterRecord",
  "type": "object",
  "required": ["schema_version", "conformance_line", "canonical_path", "retention_policy", "atomic_write_policy", "cluster_id", "project_id", "cluster_topic", "centroid_method", "similarity_threshold", "crystallization_threshold", "memory_ids", "memory_count", "support_refs", "cluster_status", "supersedes", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": "skill.knowledge_cluster.v1" },
    "conformance_line": { "const": "M16.knowledge_cluster" },
    "canonical_path": { "type": "string", "minLength": 1 },
    "retention_policy": { "type": "string", "minLength": 1 },
    "atomic_write_policy": { "type": "string", "minLength": 1 },
    "cluster_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "cluster_topic": { "type": "string", "minLength": 1 },
    "centroid_method": { "type": "string", "minLength": 1 },
    "similarity_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "crystallization_threshold": { "type": "integer", "minimum": 2 },
    "memory_ids": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
    "memory_count": { "type": "integer", "minimum": 2 },
    "support_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "cluster_status": { "enum": ["ready_for_crystallization", "insufficient_members", "superseded"] },
    "supersedes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
