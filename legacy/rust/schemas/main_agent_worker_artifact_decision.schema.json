{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "main_agent_worker_artifact_decision.schema.json",
  "title": "MainAgentWorkerArtifactDecision",
  "type": "object",
  "required": [
    "schema_version",
    "decision_id",
    "decision_ref",
    "agent_id",
    "task_id",
    "candidate_refs",
    "decision",
    "rationale",
    "canonical_target_refs",
    "review_required",
    "cleanup_required",
    "readiness_refs",
    "project_id",
    "created_at",
    "published_by",
    "authority_note"
  ],
  "properties": {
    "schema_version": { "const": "main_agent_worker_artifact_decision.v1" },
    "decision_id": { "type": "string", "minLength": 1 },
    "decision_ref": {
      "type": "string",
      "pattern": "^main_agent_worker_artifact_decision::.+$"
    },
    "agent_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "candidate_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "decision": {
      "type": "string",
      "enum": ["accept", "reject", "defer"]
    },
    "rationale": { "type": "string", "minLength": 1 },
    "adoption_scope": {
      "type": ["string", "null"]
    },
    "canonical_target_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "review_required": { "type": "boolean" },
    "cleanup_required": { "type": "boolean" },
    "readiness_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "project_id": { "type": "string", "minLength": 1 },
    "job_id": {
      "type": ["string", "null"]
    },
    "stage_id": {
      "type": ["string", "null"]
    },
    "stage_execution_id": {
      "type": ["string", "null"]
    },
    "created_at": { "type": "string", "minLength": 1 },
    "published_by": { "const": "main_agent" },
    "authority_note": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
