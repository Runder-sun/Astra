{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research_turn_classification.schema.json",
  "title": "ResearchTurnClassification",
  "type": "object",
  "required": [
    "schema_version",
    "conformance_line",
    "classification_id",
    "thread_id",
    "stage_execution_id",
    "span_id",
    "research_relevant",
    "inferred_stage_id",
    "inferred_mode",
    "candidate_operation",
    "confidence",
    "evidence_refs",
    "alternative_interpretations",
    "human_gate_required",
    "natural_language_summary",
    "next_recommended_action",
    "dry_run"
  ],
  "properties": {
    "schema_version": { "const": "research_turn_classification.v1" },
    "conformance_line": { "const": "M10.research_runtime" },
    "classification_id": { "type": "string", "minLength": 1 },
    "thread_id": { "type": ["string", "null"], "minLength": 1 },
    "stage_execution_id": { "type": ["string", "null"], "minLength": 1 },
    "span_id": { "type": ["string", "null"], "minLength": 1 },
    "research_relevant": { "type": "boolean" },
    "inferred_stage_id": { "type": ["string", "null"], "minLength": 1 },
    "inferred_mode": {
      "enum": [
        "exploring",
        "comparing",
        "reviewing",
        "debugging",
        "interpreting_results",
        "drafting",
        "awaiting_human_gate",
        "ready_to_record",
        "ready_to_execute",
        null
      ]
    },
    "candidate_operation": {
      "enum": [
        "advance",
        "retry",
        "repair",
        "pivot",
        "fork",
        "supersede",
        "abandon",
        "human_override",
        null
      ]
    },
    "confidence": { "enum": ["low", "medium", "high"] },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "alternative_interpretations": {
      "type": "array",
      "items": {
        "enum": [
          "advance",
          "retry",
          "repair",
          "pivot",
          "fork",
          "supersede",
          "abandon",
          "human_override",
          "ordinary_session_turn"
        ]
      }
    },
    "human_gate_required": { "type": "boolean" },
    "natural_language_summary": { "type": "string" },
    "next_recommended_action": { "type": "string", "minLength": 1 },
    "dry_run": { "type": "boolean" }
  },
  "additionalProperties": false
}
