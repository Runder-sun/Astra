{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mission_frame.schema.json",
  "title": "MissionFrame",
  "type": "object",
  "required": [
    "frame_id",
    "version",
    "project_id",
    "project_max_goal",
    "milestone_goal",
    "current_implementation_goal",
    "priority_rule",
    "non_goals",
    "success_criteria",
    "evidence_refs",
    "risk_notes",
    "updated_at"
  ],
  "properties": {
    "frame_id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "project_max_goal": { "type": "string", "minLength": 1 },
    "milestone_goal": { "type": "string", "minLength": 1 },
    "current_implementation_goal": { "type": "string", "minLength": 1 },
    "priority_rule": {
      "const": "project_max_goal > milestone_goal > current_implementation_goal"
    },
    "non_goals": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "success_criteria": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "risk_notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "automation_mode": {
      "enum": ["human_in_the_loop", "high_autonomy", "full_auto"],
      "default": "human_in_the_loop"
    },
    "updated_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
