{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory_record.schema.json",
  "title": "MemoryRecord",
  "type": "object",
  "required": [
    "schema_version",
    "conformance_line",
    "canonical_path",
    "retention_policy",
    "atomic_write_policy",
    "record_id",
    "project_id",
    "namespace",
    "scope",
    "kind",
    "surface",
    "title",
    "summary",
    "body",
    "provenance",
    "source_candidate_id",
    "source_session_id",
    "source_artifacts",
    "support_refs",
    "status",
    "confidence",
    "valid_from",
    "valid_to",
    "supersedes",
    "superseded_by",
    "usage_count",
    "last_used_at",
    "injectable",
    "invalidation_reason",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "conformance_line": { "type": "string", "const": "M8.durable_memory" },
    "canonical_path": { "type": "string", "minLength": 1 },
    "retention_policy": { "type": "string", "minLength": 1 },
    "atomic_write_policy": { "type": "string", "minLength": 1 },
    "record_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "namespace": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "minLength": 1 },
    "surface": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "body": { "type": "string", "minLength": 1 },
    "provenance": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "source_candidate_id": { "type": "string", "minLength": 1 },
    "source_session_id": { "type": "string" },
    "source_artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "support_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "status": {
      "type": "string",
      "enum": ["candidate", "supported", "trusted", "contested", "superseded", "invalidated", "expired"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "valid_from": { "type": "string", "minLength": 1 },
    "valid_to": { "type": "string" },
    "supersedes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "superseded_by": { "type": "string" },
    "usage_count": { "type": "integer", "minimum": 0 },
    "last_used_at": { "type": "string" },
    "injectable": { "type": "boolean" },
    "invalidation_reason": { "type": "string" },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
