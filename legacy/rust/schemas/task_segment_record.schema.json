{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task_segment_record.schema.json",
  "title": "TaskSegmentRecord",
  "type": "object",
  "required": [
    "schema_version",
    "conformance_line",
    "canonical_path",
    "retention_policy",
    "atomic_write_policy",
    "segment_id",
    "ingest_id",
    "project_id",
    "segment_index",
    "start_line",
    "end_line",
    "message_count",
    "fingerprint",
    "topic",
    "summary",
    "segmentation_method",
    "segmentation_model",
    "segmentation_prompt_digest",
    "quality_status",
    "memory_extraction_status",
    "segment_tag",
    "status",
    "supersedes",
    "superseded_by",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "trajectory.task_segment.v1" },
    "conformance_line": { "type": "string", "const": "M15.task_segment" },
    "canonical_path": { "type": "string", "minLength": 1 },
    "retention_policy": { "type": "string", "minLength": 1 },
    "atomic_write_policy": { "type": "string", "minLength": 1 },
    "segment_id": { "type": "string", "minLength": 1 },
    "ingest_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "segment_index": { "type": "integer", "minimum": 0 },
    "start_line": { "type": "integer", "minimum": 1 },
    "end_line": { "type": "integer", "minimum": 1 },
    "message_count": { "type": "integer", "minimum": 1 },
    "fingerprint": { "type": "string", "minLength": 16, "maxLength": 16 },
    "topic": { "type": "string" },
    "summary": { "type": "string" },
    "segmentation_method": {
      "type": "string",
      "enum": ["llm", "deterministic_short_chat", "deterministic_single_task", "manual_fixture"]
    },
    "segmentation_model": { "type": "string" },
    "segmentation_prompt_digest": { "type": "string" },
    "quality_status": { "type": "string", "enum": ["pending", "labeled", "failed", "ineligible"] },
    "memory_extraction_status": {
      "type": "string",
      "enum": ["not_started", "candidate_created", "skipped", "invalidated", "failed"]
    },
    "segment_tag": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["active", "superseded", "invalidated"] },
    "supersedes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "superseded_by": { "type": "string" },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
