{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill_install_record.schema.json",
  "title": "SkillInstallRecord",
  "type": "object",
  "required": ["schema_version", "conformance_line", "canonical_path", "retention_policy", "atomic_write_policy", "install_id", "candidate_id", "skill_id", "install_state", "install_path", "manifest_path", "human_gate_approved", "support_refs", "created_at"],
  "properties": {
    "schema_version": { "const": "skill.install_record.v1" },
    "conformance_line": { "const": "M16.skill_install" },
    "canonical_path": { "type": "string", "minLength": 1 },
    "retention_policy": { "type": "string", "minLength": 1 },
    "atomic_write_policy": { "type": "string", "minLength": 1 },
    "install_id": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "skill_id": { "type": "string", "minLength": 1 },
    "install_state": { "enum": ["installed"] },
    "install_path": { "type": "string", "minLength": 1 },
    "manifest_path": { "type": "string", "minLength": 1 },
    "human_gate_approved": { "const": true },
    "support_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "created_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
