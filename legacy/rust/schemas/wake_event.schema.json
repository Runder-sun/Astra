{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wake_event.schema.json",
  "title": "WakeEvent",
  "type": "object",
  "required": [
    "wake_id",
    "run_id",
    "owner_agent_id",
    "kind",
    "urgency",
    "requires_main_system",
    "summary",
    "lease_id",
    "state"
  ],
  "properties": {
    "wake_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "owner_agent_id": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "minLength": 1 },
    "urgency": { "enum": ["low", "normal", "high", "critical"] },
    "requires_main_system": { "type": "boolean" },
    "summary": { "type": "string", "minLength": 1 },
    "details": { "type": "string" },
    "lease_id": { "type": "string" },
    "state": { "enum": ["pending", "acknowledged", "escalated", "resolved"] },
    "escalation_reason": { "type": "string" },
    "no_owner_reason": { "type": "string" },
    "acknowledged_by": { "type": "string" },
    "acknowledged_at": { "type": "string" },
    "resolved_at": { "type": "string" },
    "resolution": { "type": "string" },
    "escalated_at": { "type": "string" }
  },
  "additionalProperties": false
}
