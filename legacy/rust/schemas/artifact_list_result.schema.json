{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact_list_result.schema.json",
  "title": "ArtifactListResult",
  "type": "object",
  "required": ["families", "total_count"],
  "properties": {
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "family",
          "canonical_path",
          "manifest_path",
          "canonical_id",
          "latest_id",
          "archive_ids",
          "status",
          "artifact_count"
        ],
        "properties": {
          "family": { "type": "string", "minLength": 1 },
          "canonical_path": { "type": "string", "minLength": 1 },
          "manifest_path": { "type": "string", "minLength": 1 },
          "canonical_id": { "type": ["string", "null"] },
          "latest_id": { "type": ["string", "null"] },
          "archive_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "status": { "type": "string", "minLength": 1 },
          "artifact_count": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "total_count": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
