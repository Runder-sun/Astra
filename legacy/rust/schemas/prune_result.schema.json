{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prune_result.schema.json",
  "title": "PruneResult",
  "type": "object",
  "required": [
    "dry_run",
    "candidate_refs",
    "pruned_refs",
    "blocking_conflicts"
  ],
  "properties": {
    "dry_run": {
      "type": "boolean"
    },
    "candidate_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pruned_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blocking_conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
