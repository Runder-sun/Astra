{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact_inspection_result.schema.json",
  "title": "ArtifactInspectionResult",
  "type": "object",
  "required": [
    "target",
    "canonical_path",
    "manifest",
    "lineage",
    "promotion_history",
    "review_links"
  ],
  "properties": {
    "target": { "type": "string", "minLength": 1 },
    "canonical_path": { "type": "string", "minLength": 1 },
    "manifest": { "$ref": "artifact_family.schema.json" },
    "lineage": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "promotion_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event", "artifact_id", "detail"],
        "properties": {
          "event": { "type": "string", "minLength": 1 },
          "artifact_id": { "type": "string", "minLength": 1 },
          "detail": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "review_links": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
