{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "permission_decision_trace.schema.json",
  "title": "PermissionDecisionTrace",
  "type": "object",
  "required": [
    "action",
    "allowlist_match",
    "approved",
    "branch_boundary_ok",
    "current_mode",
    "destructive",
    "reason",
    "request_id",
    "required_mode",
    "tool_name",
    "workspace_boundary_ok"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "tool_name": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "requested_path": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "required_mode": {
      "type": "string",
      "enum": ["read-only", "workspace-write", "danger-full-access"]
    },
    "current_mode": {
      "type": "string",
      "enum": ["read-only", "workspace-write", "danger-full-access"]
    },
    "allowlist_match": {
      "type": "boolean"
    },
    "workspace_boundary_ok": {
      "type": "boolean"
    },
    "branch_boundary_ok": {
      "type": "boolean"
    },
    "destructive": {
      "type": "boolean"
    },
    "approved": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
