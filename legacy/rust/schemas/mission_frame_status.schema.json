{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mission_frame_status.schema.json",
  "title": "MissionFrameStatus",
  "type": "object",
  "required": [
    "status",
    "project_id",
    "mission_frame_ref",
    "mission_frame",
    "projection",
    "task_pool",
    "warnings"
  ],
  "properties": {
    "status": { "enum": ["active", "missing"] },
    "project_id": { "type": "string", "minLength": 1 },
    "mission_frame_ref": { "type": "string" },
    "mission_frame": {
      "anyOf": [
        { "$ref": "#/$defs/missionFrame" },
        { "type": "null" }
      ]
    },
    "projection": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "mission_frame_ref",
            "project_max_goal",
            "milestone_goal",
            "current_implementation_goal",
            "priority_rule",
            "automation_mode"
          ],
          "properties": {
            "mission_frame_ref": { "type": "string", "minLength": 1 },
            "project_max_goal": { "type": "string", "minLength": 1 },
            "milestone_goal": { "type": "string", "minLength": 1 },
            "current_implementation_goal": { "type": "string", "minLength": 1 },
            "priority_rule": {
              "const": "project_max_goal > milestone_goal > current_implementation_goal"
            },
            "automation_mode": {
              "enum": ["human_in_the_loop", "high_autonomy", "full_auto"]
            }
          },
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "task_pool": { "$ref": "#/$defs/goalTaskPoolSnapshot" },
    "stage_decision_policy": { "type": "object" },
    "watch_plan": { "type": "object" },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "missionFrame": {
      "type": "object",
      "required": [
        "frame_id",
        "version",
        "project_id",
        "project_max_goal",
        "milestone_goal",
        "current_implementation_goal",
        "priority_rule",
        "non_goals",
        "success_criteria",
        "evidence_refs",
        "risk_notes",
        "updated_at"
      ],
      "properties": {
        "frame_id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "project_max_goal": { "type": "string", "minLength": 1 },
        "milestone_goal": { "type": "string", "minLength": 1 },
        "current_implementation_goal": { "type": "string", "minLength": 1 },
        "priority_rule": {
          "const": "project_max_goal > milestone_goal > current_implementation_goal"
        },
        "automation_mode": {
          "enum": ["human_in_the_loop", "high_autonomy", "full_auto"],
          "default": "human_in_the_loop"
        },
        "non_goals": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "success_criteria": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "risk_notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "updated_at": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "goalTaskPoolSnapshot": {
      "type": "object",
      "required": [
        "schema_version",
        "authority_model",
        "source",
        "project_id",
        "automation_mode",
        "summary",
        "entries",
        "next_recommended_action"
      ],
      "properties": {
        "schema_version": { "const": "goal_task_pool_snapshot.v1" },
        "authority_model": {
          "const": "derived_from_existing_goal_orchestration_research_authorities"
        },
        "source": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "automation_mode": {
          "enum": ["human_in_the_loop", "high_autonomy", "full_auto"]
        },
        "target_run": {
          "anyOf": [
            { "$ref": "#/$defs/goalTargetRunSnapshot" },
            { "type": "null" }
          ]
        },
        "summary": { "$ref": "#/$defs/goalTaskPoolSummary" },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/goalTaskPoolEntry" }
        },
        "next_recommended_action": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "goalTargetRunSnapshot": {
      "type": "object",
      "required": [
        "run_id",
        "objective",
        "status",
        "progress_percent",
        "done_steps",
        "total_steps",
        "blocked_steps"
      ],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "progress_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "done_steps": { "type": "integer", "minimum": 0 },
        "total_steps": { "type": "integer", "minimum": 0 },
        "blocked_steps": { "type": "integer", "minimum": 0 },
        "current_step_id": { "type": ["string", "null"], "minLength": 1 },
        "current_step_title": { "type": ["string", "null"], "minLength": 1 }
      },
      "additionalProperties": false
    },
    "goalTaskPoolSummary": {
      "type": "object",
      "required": [
        "total",
        "ready_to_run",
        "running",
        "needs_approval",
        "needs_review",
        "blocked"
      ],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "ready_to_run": { "type": "integer", "minimum": 0 },
        "running": { "type": "integer", "minimum": 0 },
        "needs_approval": { "type": "integer", "minimum": 0 },
        "needs_review": { "type": "integer", "minimum": 0 },
        "waiting_on_dependencies": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "goalTaskPoolEntry": {
      "type": "object",
      "required": [
        "entry_id",
        "bucket_id",
        "title",
        "summary",
        "status",
        "source",
        "recommended_command"
      ],
      "properties": {
        "entry_id": { "type": "string", "minLength": 1 },
        "bucket_id": {
          "enum": [
            "ready_to_run",
            "running",
            "needs_approval",
            "needs_review",
            "blocked",
            "repair_or_pivot"
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "status": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/goalTaskPoolEntrySource" },
        "action_policy": {
          "type": ["string", "null"],
          "enum": ["allowed", "requires_approval", "hard_blocked", null]
        },
        "action_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/goalTaskPoolEntryActionRef" }
        },
        "recommended_command": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "goalTaskPoolEntryActionRef": {
      "type": "object",
      "required": ["action_id", "label", "requires_input", "intent"],
      "properties": {
        "action_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "requires_input": { "type": "boolean" },
        "input_key": { "type": ["string", "null"], "minLength": 1 },
        "input_value": { "type": ["string", "null"] },
        "intent": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "goalTaskPoolEntrySource": {
      "type": "object",
      "required": ["source_kind", "source_id"],
      "properties": {
        "source_kind": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
