{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compact_result.schema.json",
  "title": "CompactResult",
  "type": "object",
  "required": [
    "session_id",
    "compaction_record_id",
    "summary_ref",
    "promotion_candidate_id",
    "promotion_queue_status",
    "digest_candidate_id",
    "digest_candidate_status",
    "projectops_tick_id",
    "silent_summary_staged",
    "durable_memory_promoted",
    "resume_recap_ref",
    "compacted_turn_count",
    "raw_log_retained",
    "lineage_ok",
    "derived_views_updated",
    "deferred_repairs"
  ],
  "properties": {
    "session_id": { "type": "string", "minLength": 1 },
    "compaction_record_id": { "type": "string", "minLength": 1 },
    "summary_ref": { "type": "string", "minLength": 1 },
    "mission_frame_ref": { "type": "string" },
    "mission_frame": { "type": ["object", "null"] },
    "doc_context": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "schema_version",
            "conformance_line",
            "projection_policy",
            "project_id",
            "generated_at",
            "doc_frames",
            "active_count",
            "injected_count",
            "omitted_active_count",
            "stale_count",
            "omitted_stale_count",
            "evidence_refs"
          ],
          "properties": {
            "schema_version": { "const": "doc_context_projection.v1" },
            "conformance_line": { "const": "M7.docframe_context" },
            "projection_policy": {
              "const": "active_non_stale_docframes_after_mission_frame"
            },
            "project_id": { "type": "string", "minLength": 1 },
            "generated_at": { "type": "string", "minLength": 1 },
            "doc_frames": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "doc_id",
                  "schema_version",
                  "source_path",
                  "title",
                  "doc_type",
                  "lifecycle",
                  "scope",
                  "summary",
                  "generated_by",
                  "updated_at"
                ],
                "properties": {
                  "doc_id": { "type": "string", "minLength": 1 },
                  "schema_version": { "type": "string", "minLength": 1 },
                  "source_path": { "type": "string", "minLength": 1 },
                  "title": { "type": "string", "minLength": 1 },
                  "doc_type": { "type": "string", "minLength": 1 },
                  "lifecycle": { "type": "string", "minLength": 1 },
                  "scope": { "type": "string", "minLength": 1 },
                  "milestone": { "type": "string" },
                  "summary": { "type": "string", "minLength": 1 },
                  "key_claims": { "type": "array", "items": { "type": "string" } },
                  "decisions": { "type": "array", "items": { "type": "string" } },
                  "interfaces": { "type": "array", "items": { "type": "string" } },
                  "evidence_refs": { "type": "array", "items": { "type": "string" } },
                  "next_actions": { "type": "array", "items": { "type": "string" } },
                  "non_goals": { "type": "array", "items": { "type": "string" } },
                  "generated_by": { "type": "string", "minLength": 1 },
                  "updated_at": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            },
            "active_count": { "type": "integer", "minimum": 0 },
            "injected_count": { "type": "integer", "minimum": 0 },
            "omitted_active_count": { "type": "integer", "minimum": 0 },
            "stale_count": { "type": "integer", "minimum": 0 },
            "omitted_stale_count": { "type": "integer", "minimum": 0 },
            "evidence_refs": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "research_context": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "schema_version",
            "conformance_line",
            "project_id",
            "active_thread_id",
            "active_thread_title",
            "active_stage_execution_id",
            "active_stage_id",
            "active_stage_class",
            "active_deliberation_span_id",
            "active_deliberation_mode",
            "pending_operations",
            "open_questions",
            "agreed_decisions",
            "evidence_refs",
            "next_recommended_action",
            "confidence",
            "projection_policy"
          ],
          "properties": {
            "schema_version": { "const": "research_context_projection.v1" },
            "conformance_line": { "const": "M10.research_runtime" },
            "project_id": { "type": "string", "minLength": 1 },
            "active_thread_id": { "type": "string", "minLength": 1 },
            "active_thread_title": { "type": "string", "minLength": 1 },
            "active_stage_execution_id": { "type": "string" },
            "active_stage_id": { "type": "string" },
            "active_stage_class": { "type": "string" },
            "active_deliberation_span_id": { "type": "string" },
            "active_deliberation_mode": { "type": "string" },
            "pending_operations": { "type": "array", "items": { "type": "string" } },
            "open_questions": { "type": "array", "items": { "type": "string" } },
            "agreed_decisions": { "type": "array", "items": { "type": "string" } },
            "evidence_refs": { "type": "array", "items": { "type": "string" } },
            "next_recommended_action": { "type": "string", "minLength": 1 },
            "confidence": { "enum": ["low", "medium", "high"] },
            "projection_policy": { "const": "bounded_after_mission_frame_before_memory" }
          },
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "skill_outputs": {
      "type": "object",
      "required": [
        "schema_version",
        "conformance_line",
        "projection_policy",
        "public_latest",
        "evolved_recommendations",
        "review_candidate_count",
        "private_candidate_count",
        "omitted_candidate_count"
      ],
      "properties": {
        "schema_version": { "const": "skill_output_context_projection.v1" },
        "conformance_line": { "const": "M11.skill_publication" },
        "projection_policy": { "const": "public_latest_plus_verified_evolution_recommendations" },
        "public_latest": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "envelope_id",
              "artifact_id",
              "artifact_path",
              "doc_frame_ref",
              "published_at"
            ],
            "properties": {
              "envelope_id": { "type": "string", "minLength": 1 },
              "artifact_id": { "type": "string" },
              "artifact_path": { "type": "string" },
              "doc_frame_ref": { "type": "string" },
              "published_at": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "evolved_recommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "candidate_id",
              "cluster_id",
              "skill_id",
              "title",
              "trigger",
              "skill_artifact_path",
              "verification_status",
              "publication_status",
              "recommendation_reason",
              "support_refs"
            ],
            "properties": {
              "candidate_id": { "type": "string", "minLength": 1 },
              "cluster_id": { "type": "string", "minLength": 1 },
              "skill_id": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "trigger": { "type": "string", "minLength": 1 },
              "skill_artifact_path": { "type": "string", "minLength": 1 },
              "verification_status": { "const": "verified" },
              "publication_status": { "enum": ["not_submitted", "submitted_to_m11_governance"] },
              "recommendation_reason": { "const": "verified_evolved_skill_candidate_advisory_only" },
              "support_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            },
            "additionalProperties": false
          }
        },
        "review_candidate_count": { "type": "integer", "minimum": 0 },
        "private_candidate_count": { "type": "integer", "minimum": 0 },
        "omitted_candidate_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "promotion_candidate_id": { "type": "string", "minLength": 1 },
    "promotion_queue_status": { "type": "string", "minLength": 1 },
    "digest_candidate_id": { "type": "string", "minLength": 1 },
    "digest_candidate_status": { "type": "string", "minLength": 1 },
    "projectops_tick_id": { "type": "string", "minLength": 1 },
    "silent_summary_staged": { "type": "boolean" },
    "durable_memory_promoted": { "type": "boolean" },
    "resume_recap_ref": { "type": "string", "minLength": 1 },
    "compacted_turn_count": { "type": "integer", "minimum": 0 },
    "raw_log_retained": { "type": "boolean" },
    "lineage_ok": { "type": "boolean" },
    "derived_views_updated": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "deferred_repairs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
