{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command_failure.schema.json",
  "title": "CommandFailure",
  "type": "object",
  "required": ["ok", "command", "error"],
  "properties": {
    "ok": {
      "const": false
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "error": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "data": {}
  },
  "additionalProperties": false
}
