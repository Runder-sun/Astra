{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "branch_list_result.schema.json",
  "title": "BranchListResult",
  "type": "object",
  "required": [
    "schema_version",
    "conformance_line",
    "total_count",
    "branch_runs"
  ],
  "properties": {
    "schema_version": { "const": "branch_list_result.v1" },
    "conformance_line": { "const": "M9.branch_inventory" },
    "total_count": { "type": "integer", "minimum": 0 },
    "branch_runs": {
      "type": "array",
      "items": { "$ref": "branch_run_record.schema.json" }
    }
  },
  "additionalProperties": false
}
