{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool_error_recovery.schema.json",
  "title": "ToolErrorRecovery",
  "type": "object",
  "required": [
    "schema_version",
    "conformance_line",
    "recovery_id",
    "failed_tool",
    "error_class",
    "retryable",
    "suggested_alternatives",
    "human_gate_required",
    "recovery_summary",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "tool_error_recovery.v1" },
    "conformance_line": { "const": "M13.research_ux_middleware" },
    "recovery_id": { "type": "string", "minLength": 1 },
    "failed_tool": { "type": "string", "minLength": 1 },
    "error_class": { "type": "string", "minLength": 1 },
    "retryable": { "type": "boolean" },
    "suggested_alternatives": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "human_gate_required": { "type": "boolean" },
    "recovery_summary": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
