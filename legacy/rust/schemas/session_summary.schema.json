{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session_summary.schema.json",
  "title": "SessionSummary",
  "type": "object",
  "required": ["session_id", "summary_ref"],
  "properties": {
    "session_id": { "type": "string", "minLength": 1 },
    "summary_ref": { "type": "string", "minLength": 1 },
    "resume_recap_ref": { "type": "string" },
    "compacted_turn_count": { "type": "integer", "minimum": 0 },
    "created_at": { "type": "string" },
    "mission_frame_ref": { "type": "string" }
  },
  "additionalProperties": true
}
