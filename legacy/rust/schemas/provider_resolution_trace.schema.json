{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provider_resolution_trace.schema.json",
  "title": "ProviderResolutionTrace",
  "type": "object",
  "required": [
    "resolved_provider",
    "resolved_model",
    "routed_by_prefix",
    "degraded",
    "sources"
  ],
  "properties": {
    "requested_model": { "type": "string" },
    "requested_provider": { "type": "string" },
    "model_alias_applied": { "type": "string" },
    "routed_by_prefix": { "type": "boolean" },
    "resolved_provider": { "type": "string" },
    "resolved_model": { "type": "string" },
    "resolution_reason": { "type": "string" },
    "degraded": { "type": "boolean" },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sources": {
      "type": "object",
      "properties": {
        "model": { "type": "string" },
        "provider": { "type": "string" }
      },
      "additionalProperties": false
    },
    "provider_id": { "type": "string" },
    "auth_status": { "type": "string" },
    "auth_source": { "type": "string" },
    "auth_env_var": { "type": "string" },
    "auth_shape": { "type": "string" },
    "base_url": { "type": "string" },
    "base_url_source": { "type": "string" },
    "catalog_source": { "type": "string" },
    "supported_models": {
      "type": "array",
      "items": { "type": "string" }
    },
    "api_surface": { "type": "string" },
    "api_surface_source": { "type": "string" },
    "responses_tool_schema": { "type": "string" },
    "responses_tool_schema_source": { "type": "string" },
    "chat_completion_streaming": { "type": "boolean" },
    "chat_completion_streaming_source": { "type": "string" },
    "degraded_features": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
