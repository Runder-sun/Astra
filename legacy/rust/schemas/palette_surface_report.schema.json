{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "palette_surface_report.schema.json",
  "title": "PaletteSurfaceReport",
  "type": "object",
  "required": ["scope", "entries"],
  "properties": {
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "summary"],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "shortcut_hint": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
