{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "host_surface_action.schema.json",
  "title": "HostSurfaceAction",
  "type": "object",
  "required": ["action_id", "label", "surface", "gate", "enabled", "command"],
  "properties": {
    "action_id": {
      "type": "string",
      "enum": [
        "ack_hitl",
        "advance_research_loop",
        "approve_permission",
        "decide_research_stage",
        "deny_permission",
        "inspect_memory",
        "inspect_recovery_governance",
        "interrupt_turn",
        "open_artifact",
        "open_research",
        "open_research_board",
        "open_routines",
        "remote_attach",
        "retry_routine_trigger",
        "resize_terminal",
        "steer_turn",
        "submit_prompt",
        "switch_session",
        "terminal_attach",
        "terminal_replay"
      ]
    },
    "label": { "type": "string", "minLength": 1 },
    "surface": {
      "type": "string",
      "enum": ["tui_web_mobile", "web_mobile", "web_mobile_tui"]
    },
    "gate": { "type": "string", "minLength": 1 },
    "enabled": { "type": "boolean" },
    "disabled_reason": { "type": "string", "minLength": 1 },
    "control_contract": {
      "type": "string",
      "enum": [
        "direct_runtime_cancellation",
        "goal_tick_existing_authorities",
        "notification_backed_interrupt_request",
        "research_decide_existing_stage_gate",
        "routine_retry_budget_and_backoff"
      ]
    },
    "fallback_control_contract": {
      "type": "string",
      "enum": ["notification_backed_interrupt_request"]
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "requires_trigger_id": { "type": "boolean" }
  },
  "additionalProperties": false
}
