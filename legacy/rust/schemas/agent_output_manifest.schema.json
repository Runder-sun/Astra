{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_output_manifest.schema.json",
  "title": "AgentOutputManifest",
  "type": "object",
  "required": [
    "schema_version",
    "agent_id",
    "manifest_id",
    "status",
    "output_refs",
    "validation_status",
    "validation_errors",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string", "minLength": 1 },
    "manifest_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "output_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "ref", "summary"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "ref": { "type": "string", "minLength": 1 },
          "summary": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "validation_status": { "type": "string", "minLength": 1 },
    "validation_errors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "created_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
