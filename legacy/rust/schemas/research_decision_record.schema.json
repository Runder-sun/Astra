{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research_decision_record.schema.json",
  "title": "ResearchDecisionRecord",
  "type": "object",
  "required": [
    "schema_version",
    "conformance_line",
    "decision_id",
    "thread_id",
    "operation",
    "decision",
    "reason",
    "evidence_refs",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "research_decision_record.v1" },
    "conformance_line": { "const": "M10.research_runtime" },
    "decision_id": { "type": "string", "minLength": 1 },
    "thread_id": { "type": "string", "minLength": 1 },
    "operation": { "enum": ["advance", "retry", "repair", "pivot", "fork", "supersede", "abandon", "human_override"] },
    "decision": { "enum": ["approve", "reject", "revise"] },
    "reason": { "type": "string" },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "created_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
