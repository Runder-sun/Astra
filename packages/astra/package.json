{
	"name": "@earendil-works/pi-astra",
	"version": "0.1.0-alpha.1",
	"description": "Astra research domain layer for the Pi agent harness",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"astra": "dist/launcher.js",
		"astra-workbench": "dist/workbench.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"license": "MIT",
	"files": ["dist", "skills", "web", "README.md", "LICENSE", "REVIEW_REPAIR_AUDIT.md"],
	"scripts": {
		"build": "tsgo -p tsconfig.build.json && shx mkdir -p dist/skills/astra && shx cp skills/astra/*.md dist/skills/astra/ && shx chmod +x dist/launcher.js dist/workbench.js",
		"test": "vitest --run"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "^0.84.1",
		"@earendil-works/pi-coding-agent": "^0.84.1",
		"fast-xml-parser": "5.7.3",
		"shx": "0.4.0",
		"typebox": "1.3.7",
		"undici": "8.9.0"
	},
	"devDependencies": {
		"@types/node": "24.12.4",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
